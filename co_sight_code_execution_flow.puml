@startuml
' PlantUML aequence diagram generated by Gemini
' Based on co_sight_drawio_code_execution_flow_description.txt

title Co-Sight Code Execution Flow

autonumber

!theme vibrant

participant "User" as User
participant "Co-Sight UI" as UI
participant "Search Router" as Router
participant "CoSight Orchestrator" as Orchestrator
participant "Task Planner Agent" as Planner
participant "Task Actor Agent" as Actor
participant "Base Agent" as BaseAgent
participant "Plan Object" as Plan
participant "Event Manager" as EventManager
participant "LLM Service" as LLM
participant "Toolkits" as Tools
participant "Workspace" as Workspace

User -> UI: Input Query
UI -> Router: POST /deep-research/search

Router -> Router: Create task_workspace & plan_queue
Router -> EventManager: Subscribe to plan events
Router -> Orchestrator: (Thread) run_manus(query)
note right of Router: Returns StreamingResponse to UI

== Initial Planning Phase ==

Orchestrator -> Plan: Create Plan object
Orchestrator -> Planner: Create TaskPlannerAgent
Orchestrator -> Planner: create_plan(query)
Planner -> BaseAgent: execute(planning_prompt)
BaseAgent -> LLM: create_with_tools(prompt, planner_tools)
LLM --> BaseAgent: tool_call: create_plan(...)
BaseAgent -> Tools: PlanToolkit.create_plan(...)
Tools -> Plan: update(title, steps, ...)
Plan -> EventManager: publish("plan_created", plan_data)
EventManager -> Router: callback(plan_data)
Router --> UI: Stream initial plan
UI -> User: Display initial plan

== Step Execution Loop (for each ready step) ==

loop For each ready step
    Orchestrator -> Plan: get_ready_steps()
    Orchestrator -> Actor: (Thread) execute_step_thread(step)
    
    Actor -> Plan: mark_step(status="in_progress")
    Plan -> EventManager: publish("plan_process", progress_data)
    EventManager -> Router: callback(progress_data)
    Router --> UI: Stream step progress
    UI -> UI: Update UI with progress
    
    Actor -> BaseAgent: execute(actor_prompt)
    BaseAgent -> LLM: create_with_tools(prompt, actor_tools)
    LLM --> BaseAgent: tool_call: e.g., search_google() or file_saver()
    BaseAgent -> Tools: Execute tool (e.g., SearchToolkit, FileToolkit)
    Tools -> Workspace: (if applicable) Write to file
    Tools --> BaseAgent: Return tool output
    
    BaseAgent -> LLM: create_with_tools(history_with_output, ...)
    LLM --> BaseAgent: tool_call: mark_step(status="completed")
    BaseAgent -> Tools: ActToolkit.mark_step(...)
    Tools -> Plan: mark_step(status="completed", notes, ...)
    note right of Plan: Scans notes & workspace for file links
    
    Plan -> EventManager: publish("plan_process", completed_data)
    EventManager -> Router: callback(completed_data)
    Router --> UI: Stream step completion
    UI -> UI: Update step status and display files
end

== Finalization Phase ==

Orchestrator -> Planner: finalize_plan(query, plan.format())
Planner -> LLM: chat_to_llm(final_summary_prompt)
LLM --> Planner: Return final summary
Planner -> Plan: set_plan_result(summary)
Plan -> EventManager: publish("plan_result", final_data)
EventManager -> Router: callback(final_data)
Router --> UI: Stream final result
UI -> User: Display final report

@enduml