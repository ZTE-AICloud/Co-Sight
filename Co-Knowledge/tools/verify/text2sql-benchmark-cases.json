{
  "comment": "Text2SQL 评测集。expectTables 用于 Table Recall；expectError 表示应当被拒绝并返回该错误码。",
  "cases": [
    {"id": "single-count", "kind": "query", "question": "订单总数是多少",
     "expectTables": ["public.order_info"]},
    {"id": "agg-by-status", "kind": "query", "question": "各订单状态的订单数量分别是多少",
     "expectTables": ["public.order_info"]},
    {"id": "agg-sum", "kind": "query", "question": "已支付订单的总金额是多少",
     "expectTables": ["public.order_info"]},
    {"id": "two-hop-join", "kind": "query", "question": "每个城市的支付金额合计，按金额从高到低排序",
     "expectTables": ["public.order_info", "public.user_info", "public.region_info"]},
    {"id": "time-range", "kind": "query", "question": "最近30天每天的支付金额",
     "expectTables": ["public.order_info"]},
    {"id": "enum-value", "kind": "query", "question": "已支付的订单有多少",
     "expectTables": ["public.order_info"]},
    {"id": "distinct-metric", "kind": "query", "question": "付费用户数是多少",
     "expectTables": ["public.order_info"]},
    {"id": "single-table-column", "kind": "query", "question": "城市列表有哪些",
     "expectTables": ["public.region_info"]},

    {"id": "guard-delete", "kind": "guard", "sql": "DELETE FROM public.order_info",
     "expectError": "SQL_UNSAFE"},
    {"id": "guard-multi-statement", "kind": "guard", "sql": "SELECT 1; DROP TABLE public.order_info",
     "expectError": "SQL_UNSAFE"},
    {"id": "guard-unknown-table", "kind": "guard", "sql": "SELECT * FROM public.secret",
     "expectError": "SQL_TABLE_NOT_ALLOWED"},
    {"id": "guard-lock", "kind": "guard", "sql": "SELECT * FROM public.order_info FOR UPDATE",
     "expectError": "SQL_UNSAFE"},
    {"id": "guard-xml-bypass", "kind": "guard",
     "sql": "SELECT query_to_xml('SELECT count(*) FROM pg_catalog.pg_class', true, false, '')",
     "expectError": "SQL_FUNCTION_NOT_ALLOWED"},
    {"id": "guard-unknown-column", "kind": "guard", "sql": "SELECT no_such_column FROM public.order_info",
     "expectError": "SQL_COLUMN_NOT_ALLOWED"},
    {"id": "guard-multi-group-by", "kind": "sql", "sql": "SELECT status, user_id, count(*) AS n FROM public.order_info GROUP BY status, user_id",
     "expectError": null},
    {"id": "guard-oversized-cell", "kind": "sql", "sql": "SELECT repeat('x', 500000) AS big FROM public.order_info LIMIT 5",
     "expectError": null}
  ]
}
