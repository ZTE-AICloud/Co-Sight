BASE_URL=/
VUE_APP_SYSTEM=ragstudio
# 路由模式：hash 与 README 中的 `/#/knowledge` 深链一致。
VUE_APP_ROUTE_MODE=hash

# 后端 API 前缀（构建期注入）。值必须与 backend/src/shared/prefixes.py 一致。
# 不写这三行时，只有 shared/api/endpoints.js 有默认值；其它直接读
# process.env.VUE_APP_* 的模块会拼出 `undefined/...`，被 nginx 当 SPA 路由
# 回退成 index.html（200），前端表现为「列表/下拉全空」且不报错。
VUE_APP_KBASE_BASE=/api/co-knowledge/v1
VUE_APP_WORKFLOW_BASE=/api/co-knowledge/v1
VUE_APP_QUERY_BASE=/api/co-knowledge/v1
