# Knowledge Studio 前端环境变量示例
# 使用方式：复制为 .env.local（本地开发）或对应 mode 的 .env 文件，并按需替换为真实值。
# 切勿将真实凭据提交到代码仓库。

NODE_ENV=development

# 路由模式：hash（与 README 的 `/#/knowledge` 深链一致）或留空（history）。
VUE_APP_ROUTE_MODE=hash

# 根路径部署：与 .env.production 保持一致
BASE_URL=/

# 开发态代理目标（`npm run serve` 时把 /api/co-knowledge/v1 转到后端）。
# 不设置时不代理，前端按同源相对路径请求。
VUE_APP_API=http://127.0.0.1:8091

# 后端 API 前缀；默认 /api/co-knowledge/v1，通常不需要改
VUE_APP_KBASE_BASE=/api/co-knowledge/v1
VUE_APP_WORKFLOW_BASE=/api/co-knowledge/v1
VUE_APP_QUERY_BASE=/api/co-knowledge/v1

# 外部登录页地址（可选）。不设置时登录入口指向站内 /login
VUE_APP_UAC=

# 界面默认语言（可选；未设置时跟随浏览器）
VUE_APP_LANG=

VUE_APP_SYSTEM=ragstudio
