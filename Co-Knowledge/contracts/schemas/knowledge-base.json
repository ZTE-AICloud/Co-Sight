{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragstudio.dev/schemas/knowledge-base.json",
  "title": "KnowledgeBase",
  "description": "知识库。",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id":              { "type": "string", "description": "kbaseId；新库为 16 位十六进制（64 bit），历史库为 32 位 uuid" },
    "pkId":            { "type": ["integer", "null"], "description": "kb_kbase 自增主键" },
    "name":            { "type": "string", "minLength": 1 },
    "description":     { "type": "string" },
    "type":            { "type": "string" },
    "headIcon":        { "type": "string" },
    "embeddingModel":  { "type": "string", "description": "对应 kb_embedding.model_code" },
    "embeddingDim":    { "type": "integer", "description": "建向量表时使用；须与该模型 dimension 一致" },
    "esIndexName":     { "type": "string", "description": "doc_<kbId>（文档库，与实际 ES 索引名一致）；图谱库为 graph_<kbId>" },
    "tableName":       { "type": "string", "description": "物理表名：文档库 doc_<kbId>_vector，图谱库 graph_<kbId>" },
    "status":          { "type": ["integer", "null"], "description": "KbaseStatusEnum 数值枚举（非字符串）" },
    "fileCountLimit":  { "type": "integer" },
    "category":        { "type": "integer" },
    "orgId":           { "type": "string" },
    "createdBy":       { "type": "string" },
    "createdDate":     { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$", "description": "后端按 %Y-%m-%d %H:%M:%S 输出（无时区），非 RFC 3339" },
    "lastUpdatedBy":   { "type": "string" },
    "lastUpdatedDate": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$", "description": "后端按 %Y-%m-%d %H:%M:%S 输出（无时区），非 RFC 3339" },
    "props":           { "type": ["object", "null"], "description": "扩展属性；当前列表 VO 恒为 null" },
    "currentFileCount":{ "type": ["integer", "null"], "description": "当前文件数；列表行按库统计" },
    "chunkCount":      { "type": ["integer", "null"], "description": "切片数；仅文档类知识库的详情端点返回（kbase_service.get_kbase_detail）" },
    "fullName":        { "type": ["string", "null"] },
    "fullNameEn":      { "type": ["string", "null"] },
    "action":          { "type": ["string", "null"] },
    "operatorId":      { "type": ["integer", "null"], "description": "抽图算子 id（仅图谱库）" },
    "failReason":      { "type": ["string", "null"] },
    "schemaName":      { "type": ["string", "null"], "description": "图谱模板名（仅图谱库）" },
    "schemaObj":       { "type": ["object", "null"], "description": "图谱模板内容（仅图谱库）" },
    "process":         { "type": ["string", "null"], "description": "处理阶段" },
    "processDetailInfo":{ "type": ["string", "null"], "description": "处理阶段明细：_localized_text/_localized_string_value 产出字符串，键缺失时为字面量字符串 null，无消息时为空串" }
  },
  "additionalProperties": false
}
