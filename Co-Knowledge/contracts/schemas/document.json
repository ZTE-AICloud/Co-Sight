{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragstudio.dev/schemas/document.json",
  "title": "Document",
  "description": "文档/目录节点。文件与目录同一模型，用 type 区分。",
  "type": "object",
  "required": ["id", "kbId", "type"],
  "properties": {
    "id":         { "type": "string", "description": "fileId，UUID" },
    "kbId":       { "type": "string" },
    "title":      { "type": "string", "description": "文件名或目录名" },
    "parentId":   { "type": ["string", "null"] },
    "parentPath": { "type": ["string", "null"] },
    "type":       { "type": "string", "enum": ["file", "folder"] },
    "canSpread":  { "type": ["string", "null"], "description": "Y/N；仅目录节点" },
    "status":     { "type": ["integer", "null"], "description": "FileUploadStatusEnum：0 init / -1 云盘 / -2 解析 / -3 切分 / -4 embedding / -5 落库 / 1 成功 / 2 失败" },
    "failReason": { "type": ["string", "null"] },
    "fileFrom":   { "type": ["string", "null"] },
    "fileSize":   { "type": ["integer", "null"] },
    "kType":      { "type": ["string", "null"] },
    "errorMsg":   { "type": ["string", "null"] },
    "childList":  { "type": ["array", "null"], "items": { "type": "object" } },
    "props":      { "type": ["object", "null"] },
    "idChain":    { "type": ["string", "null"] },
    "chunkCount": { "type": ["integer", "null"], "description": "仅部分列表端点返回" },
    "createdBy":       { "type": ["string", "null"] },
    "createdDate":     { "type": ["string", "null"], "format": "date-time" },
    "lastUpdatedBy":   { "type": ["string", "null"] },
    "lastUpdatedDate": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
