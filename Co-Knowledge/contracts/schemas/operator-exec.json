{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragstudio.dev/schemas/operator-exec.json",
  "title": "OperatorExecution",
  "description": "算子执行上下文与沙箱约束（05 §4.7 / §4.8）",
  "$defs": {
    "ExecutionContext": {
      "type": "object",
      "required": ["taskId", "kbId", "operatorId", "filePath"],
      "properties": {
        "taskId":          { "type": "string" },
        "kbId":            { "type": "string" },
        "filePath":        { "type": "string" },
        "operatorId":      { "type": "integer" },
        "operatorVersion": { "type": "string" },
        "args":            { "type": "object", "additionalProperties": true },
        "workDir":         { "type": "string" },
        "timeoutSeconds":  { "type": "integer", "minimum": 1, "description": "v1 默认收敛到 300s(切分)/600s(解析)，不再用现状的 86400s" }
      },
      "additionalProperties": false
    },
    "SandboxLimits": {
      "type": "object",
      "description": "v1 加固项（05 §4.8）",
      "properties": {
        "memoryLimitMB":     { "type": "integer", "default": 500 },
        "maxResultBytes":    { "type": "integer", "default": 10485760, "description": "10MB" },
        "allowNetwork":      { "type": "boolean", "default": false, "description": "v1 网络隔离尽力而为（无特权时退化为环境白名单与 AST 检查）" },
        "serialization":     { "type": "string", "enum": ["json"], "default": "json", "description": "v1 禁 pickle" }
      },
      "additionalProperties": false
    }
  }
}
