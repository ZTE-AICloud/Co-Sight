# Knowledge Studio E2E 环境变量模板
# 用法：cp .env.e2e.example .env.e2e 后按需修改；.env.e2e 已被 .gitignore 忽略。

# 运行标识：每次运行唯一，用于 compose project 与资源命名
E2E_RUN_ID=

# 被测入口（compose e2e 覆盖文件默认把 web 发布到 18080）
E2E_BASE_URL=http://127.0.0.1:18080

# 模型模式：mock（默认，确定性替身）| live（真实端点）
E2E_MODEL_MODE=mock

# fake-model-gateway 在宿主的调试端口（compose 覆盖文件映射 127.0.0.1:18081）
E2E_MOCK_BASE_URL=http://127.0.0.1:18081

# 并行度：全量默认 1（mock config/requests 是进程级全局状态）；快速门禁脚本显式传 2
E2E_WORKERS=1

# 按需门禁（默认 0）
E2E_INFRA=0
E2E_VISUAL=0
# 既有 SEC-05：栈需以 AUTH_MODE=gateway 启动
E2E_AUTH=0
E2E_AUTH_TOKEN=
# 本地账号 E2E：另起一轮栈时设 AUTH_MODE=local 并让 stack-up.sh 播种 admin
#   AUTH_MODE=local RKB_ADMIN_USERNAME=e2e-admin RKB_ADMIN_PASSWORD=... bash e2e/scripts/stack-up.sh
E2E_AUTH_MODE=none
E2E_ADMIN_USERNAME=e2e-admin
E2E_ADMIN_PASSWORD=E2eAdminPass123!
E2E_ALL_BROWSERS=0

# 韧性用例容器名（默认 e2e compose project 名）
E2E_RKB_CONTAINER=
E2E_OPENSEARCH_CONTAINER=

# 本地优先使用系统 Chrome；CI 留空并使用 `npx playwright install` 的 Chromium
E2E_BROWSER_CHANNEL=chrome

# 语言/时区
E2E_LOCALE=zh-CN
E2E_TIMEZONE=Asia/Shanghai

# 失败时保留 compose 栈（1=保留）
E2E_KEEP=0

# live 模式（仅 @live 用例使用；mock 模式忽略）
E2E_EMBEDDING_URL=
E2E_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
E2E_EMBEDDING_DIMENSION=1024
E2E_LLM_URL=
E2E_LLM_MODEL=deepseek-chat
E2E_LLM_API_KEY=
E2E_RERANK_URL=
