{
  "name": "ragstudio-e2e",
  "version": "0.2.0",
  "private": true,
  "description": "Knowledge Studio 浏览器级 E2E（Playwright 门禁 + chrome-devtools MCP 辅助）",
  "scripts": {
    "test": "playwright test",
    "test:fast": "playwright test --grep @fast --workers=2",
    "test:full": "playwright test --workers=1",
    "test:smoke": "playwright test --grep @smoke",
    "test:p0": "playwright test --grep @p0",
    "report": "playwright show-report",
    "stack:up": "bash scripts/stack-up.sh",
    "stack:down": "bash scripts/stack-down.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "jszip": "3.10.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
