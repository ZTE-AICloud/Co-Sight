# ============================================================================
# Knowledge Studio · 默认部署配置模板
# 用法：cp deploy/.env.example deploy/.env  然后按需修改（至少设置 POSTGRES_PASSWORD）
# 必须放在 deploy/ 下（与 compose 文件同目录）；放在仓库根目录不会生效。
# 说明：本文件只含占位符，不含任何真实凭据。禁止把真实口令提交进仓库。
# ============================================================================

# ---------- 构建期包源（可选，内网 / 镜像站）----------
# 默认留空 = 使用官方 PyPI 与 npm registry。内网或离线环境填镜像地址，
# 这些值会作为 build ARG 传给 backend / frontend 的 Dockerfile。
# 示例：PIP_INDEX_URL=https://mirrors.example.com/pypi/simple
#       PIP_TRUSTED_HOST=mirrors.example.com
#       NPM_REGISTRY=https://mirrors.example.com/npm/
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
NPM_REGISTRY=

# ---------- 站点部署路径（构建期）----------
# 默认根路径 /；子路径部署填 /co-knowledge/（首尾斜杠都要保留）。
# 会作为 build ARG 注入前端（publicPath + 路由 base）并决定 nginx location，
# 因此改完必须重建 web 镜像：
#     docker compose -f deploy/docker-compose.yml up -d --build web
WEB_BASE_URL=/

# ---------- PostgreSQL（pgvector）----------
# 服务名固定为 postgresql（compose 内部 DNS），通常无需改 HOST
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=rag_studio
POSTGRES_USER=rag
# 必填：首次启动用于初始化数据库超级用户口令。生产环境务必替换。
POSTGRES_PASSWORD=changeme
# 非 superuser 应用角色（应用连接用；空卷由 init/pg/05-app-role.sh 自动创建）。
# 留空 = 应用使用 POSTGRES_USER（不推荐）。
RKB_DB_USER=rag_app
RKB_DB_PASSWORD=changeme_app

# ---------- OpenSearch（2.19，关键词检索）----------
# 应用只读 RKB_ES_*（部署模板与运维脚本都按这个名字编写）；
# 当前 compose 单节点、security 插件关闭，故用户名/口令留空。
RKB_ES_HOST=opensearch
RKB_ES_PORT=9200
RKB_ES_USERNAME=
# 若 OpenSearch 开启鉴权再填（默认关闭，留空即可）。
RKB_ES_PASSWORD=
# 单节点默认 0 副本（避免集群 yellow）；多节点部署设 1。
ES_NUMBER_OF_REPLICAS=0

# ---------- embedding 端点（OpenAI 兼容，首条链路硬前置）----------
# 默认走**外部 OpenAI 兼容 embedding 端点**（需自行提供，或改用下面的本地模式）。
# 若所在网络有 HTTP 代理，**必须**把域名加进容器的 NO_PROXY（见下面的 EMBEDDING_HOST）——
# 容器会继承宿主 http_proxy，不加会被代理接走，报 `Tunnel connection failed: 302 Moved`，
# 且表现为「embedding 调用失败」而不是明显的代理问题。
# 留空 = 不播种模型行，启动后在「模型管理」注册。填真实端点才会写入注册表。
MODEL_GATEWAY_URL=
# embedding 端点路径（可配置）：本端点原生带 /v1 前缀
MODEL_GATEWAY_EMBEDDINGS_PATH=/v1/embeddings
# embedding 模型。两个名字是**同一模型的两个命名空间，别合并**：
#   EMBEDDING_MODEL      = model_code（发给端点的 model 字段）→ 建库默认写入 kb_embedding.model_code
#   EMBEDDING_MODEL_NAME = model_name（写进 kb_kbase.embedding_model，下拉里显示的就是它）
# 两列必须与模型注册表里同一模型的两个字段一致。
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_MODEL_NAME=Qwen3-Embedding-0.6B
# 向量维度（校验基准，须与模型实际输出一致）。Qwen3-Embedding-0.6B 实测 = 1024。
# 与实际不符时**建索引会显式失败**，不会静默截断或补零。
EMBEDDING_DIMENSION=1024
# embedding 端点的主机（仅用于容器 NO_PROXY 排除；改上面的 URL 时要一起改）
EMBEDDING_HOST=your-llm-endpoint.example.com
# 端点需要鉴权时填这里（默认端点不需要）
MODEL_GATEWAY_API_KEY=
# 推理型模型的「思考」开关（生成调用使用；透传为 OpenAI 兼容的
# reasoning_effort 字段）。抽图是**逐 chunk**调用，实测推理模型
# 开启思考时单次调用先产出 3 万+ 字符 reasoning、>10 分钟不返回，同一 prompt 关闭后
# ~10s 返回。端点支持该字段时建议设 none；留空 = 不发送该字段（换不支持的网关时回退成留空）。
MODEL_GATEWAY_REASONING_EFFORT=none

# 注：`model-gateway`（本地 Infinity 容器，跑 bge-base-zh-v1.5，768 维）在 compose 里由
# `profiles: ["local-embedding"]` 门控，**默认不启动**。启用它（见 README §快速开始）并把
# MODEL_GATEWAY_URL / _EMBEDDINGS_PATH 指回 http://model-gateway:8000 + /embeddings，
# 即可切到「本地 bge」路线 —— 768 维的知识库需要它才能继续导入文档
# （kb_embedding 里 bge-base-zh-v1.5 那一行仍然有效）。
# 两条路线可共存，按每个知识库的 embedding_model 字段分别解析。

# ---------- 共享文件存储 ----------
# 知识库文件域（kb-storage）。上传与解析在同一进程内共用同一路径
# （RKB_KBASE_STORAGE_PATH 与它一致）。
# local 模式下库里/任务里出现的是**绝对路径**；minio 模式下原文件是对象键，
# 但算子包（operator_path）与名称锁仍然依赖本地卷的绝对路径。
# 另注：RKB 自身的 STORAGE_MAIN_PATH 是 /data/rkb（插件/日志根），语义不同，别混。
STORAGE_MAIN_PATH=/data/kb

# ---------- 知识库文件域后端 ----------
# local（默认）：持久文件写 kb-storage 卷（RKB_KBASE_STORAGE_PATH / STORAGE_MAIN_PATH）。
# minio       ：持久文件（core/pict/dump）写对象存储；解析/切片的临时文件仍在本地。
#
# ⚠️ 两种后端下 kb-storage 都必须挂载：算子包（operator_path 是库里的绝对路径）、
#    名称锁（fcntl.flock）、清洗中间件都依赖本地卷。
# ⚠️ 选 minio 后启动栈要加 profile：
#    docker compose -f deploy/docker-compose.yml --profile minio up -d
RKB_STORAGE_BACKEND=local

# MinIO 模式下的本地 scratch（对象物化、清洗中间件）。建议放 rkb-storage。
RKB_STORAGE_TEMP_PATH=/data/rkb/tmp

# MinIO 连接（RKB_STORAGE_BACKEND=minio 时生效）
RKB_MINIO_ENDPOINT=minio:9000
RKB_MINIO_ACCESS_KEY=minioadmin
RKB_MINIO_SECRET_KEY=minioadmin
RKB_MINIO_BUCKET=rag-studio-kb
RKB_MINIO_SECURE=false
# 可选：区域 / 对象前缀（多环境或多租户共用同一个桶时用前缀隔离）
RKB_MINIO_REGION=
RKB_MINIO_PREFIX=

# ---------- 鉴权 ----------
# none    = 关闭鉴权（仅建议开发/隔离网络使用）
# local   = 本地账号登录（推荐）：账号表 + scrypt 口令 + HttpOnly 会话 Cookie
# gateway = 信任前置网关：只检查 X-Auth-Value / X-Auth-Token / Authorization 是否存在，
#           **不调外部服务、不校验签名** —— 由前置网关负责真正的鉴权，并且网关必须
#           剥离客户端伪造的 X-Emp-No 等身份头
# 未知取值（例如 `jwt`）会让服务启动失败，避免静默变成无鉴权。
AUTH_MODE=local
# 单用户模式下的默认用户（AUTH_MODE=none 或 gateway 且请求未带 X-Emp-No 时使用）
AUTH_DEFAULT_USER=admin

# ---- 本地账号（AUTH_MODE=local）----
# 首次启动且 t_auth_user 为空时创建；之后改密/建号用:
#   docker exec <rkb> python3 -m auth.cli list
#   docker exec <rkb> python3 -m auth.cli create --username alice --generate
# 密码留空 = 生成随机密码并写到 PASSWORD_FILE（0600）；首次登录强制改密。
RKB_ADMIN_USERNAME=admin
RKB_ADMIN_PASSWORD=
RKB_ADMIN_PASSWORD_FILE=/data/rkb/initial-admin-password
# 首次登录是否强制改密（生产保持 true；E2E 自动栈设为 false）
RKB_ADMIN_MUST_CHANGE=true
# 会话有效期（秒，默认 12h，范围 60s–30d）
RKB_AUTH_SESSION_TTL_SECONDS=43200
# Cookie 的 Secure 属性：auto 按请求 scheme/X-Forwarded-Proto 决定；HTTP 部署不要强制 true
# （浏览器会丢弃 Secure Cookie，表现为登录后立刻又回登录页）。
RKB_AUTH_COOKIE_SECURE=auto
# 登录失败限流：同一账号+IP 窗口内失败次数、同一 IP 窗口内总失败次数、窗口秒数
RKB_AUTH_LOGIN_MAX_FAILURES=5
RKB_AUTH_LOGIN_IP_MAX_FAILURES=20
RKB_AUTH_LOGIN_WINDOW_SECONDS=900

# ---------- Agent 接口（REST + MCP）----------
# 只读检索与引用式问答：REST 在 /api/co-knowledge/v1/agent/*，MCP 在 /api/co-knowledge/v1/mcp。
# 总开关；关闭后两段都回 404（不会落到 kb_api 的 catch-all）。
RKB_AGENT_API_ENABLED=true
# 分阶段上线用：可先只开 REST 验证检索，再开 MCP。
RKB_AGENT_REST_ENABLED=true
RKB_AGENT_MCP_ENABLED=true
# 关闭后 /answer 与 ask_knowledge_base 回 503，search 仍可用。
RKB_AGENT_ANSWER_ENABLED=true
# ⚠️ 生产必填。空值 = fail-closed（agent 路径 503，CLI 拒绝建 Key）。
# 生成方式：openssl rand -hex 32
# 轮换 pepper 会让所有已发 Key 立即失效，需与 Key 重发一起做。
RKB_AGENT_KEY_PEPPER=
# 单次请求的上限（显式 top_k / knowledge_base_ids 都受它约束）。
RKB_AGENT_MAX_TOP_K=20
RKB_AGENT_MAX_KBS=50
# 生成超时（秒）。nginx 对 /agent/ 与 /mcp 已配 300s，留出余量。
RKB_AGENT_ANSWER_TIMEOUT=120
# 留空 = 注册表里的默认 LLM；非空则强制使用它（忽略请求里的 model）。
RKB_AGENT_ANSWER_MODEL=
# 推理模型建议设 none（非空才随请求发送；严格网关可能不认这个字段）。
RKB_AGENT_REASONING_EFFORT=
# 默认不记录原始 query，只记长度。
RKB_AGENT_LOG_QUERY=false
# MCP 传输：stateless / POST 纯 JSON 默认关闭（Claude Code 兼容性最好）。
RKB_AGENT_MCP_STATELESS=false
RKB_AGENT_MCP_JSON_RESPONSE=false
# DNS rebinding 保护默认关闭（内网部署 + Bearer Key）。开启时 allowed_hosts 要同时写
# host 与 host:*（SDK 的 host:* 通配要求 Host 带端口；默认宿主端口 8080 会带 :8080，若映射到 80 则不带）。
RKB_AGENT_MCP_DNS_REBINDING_PROTECTION=false
RKB_AGENT_MCP_ALLOWED_HOSTS=
RKB_AGENT_MCP_ALLOWED_ORIGINS=
# OpenAPI servers[0].url；对外平台要求绝对地址时改成 https://<host>/api/co-knowledge/v1/agent
RKB_AGENT_PUBLIC_BASE=/api/co-knowledge/v1/agent
# UI「远程接入 → 密钥管理」接口开关（默认开启）。
# false 时 /api/co-knowledge/v1/agent-keys 的 list/create/patch/delete 返回 403 permission_denied，
# status 仍返回 adminEnabled=false，页面据此显示提示。
# ⚠️ AUTH_MODE=none 时本接口没有应用层鉴权，必须靠网络隔离/反向代理保护。
RKB_AGENT_KEY_ADMIN_ENABLED=true

# ---------- 对外 HTTP 端口（宿主）----------
# web 容器内 nginx 固定监听 80；这里只改宿主机映射端口。
# 默认 8080，避免与宿主机上的其它服务冲突；如仍冲突改成 18080 等。
WEB_PORT=8080

# ---------- 资源下限（首次部署建议值，可依据实测调小）----------
# 文件域上传档位（MB）。**留空 = 按容器 cgroup 内存上限自动推导**；
# 只有 < 800 才降级为「文档库单次 1 个文件 + 单文件上限压缩」。显式填 >= 800 可强制正常档
# （单次 50 个 + 原始大小上限：txt 5 / xlsx 10 / pptx 20 / docx 100 / pdf 150 MB）。
# 注意：这是档位阈值，不是内存分配 —— 填 1024 不会占用 1GB 内存。
MEM_LIMIT=
# 本地 bge-base-zh-v1.5 CPU 推理建议的内存上限
MODEL_GATEWAY_MEM_LIMIT=4g
POSTGRES_MEM_LIMIT=1g
OPENSEARCH_MEM_LIMIT=1.5g

# ---------- 生成与重排端点（rag-knowledge-base 使用，含编排运行期）----------
# 生成模型端点：OpenAI 兼容（/chat/completions）。默认指向 compose 内的 model-gateway，
# 但 model-gateway（Infinity）只提供 embedding，**不含生成模型** —— 要真跑编排必须指到
# 一个真实端点（例如 LiteLLM 代理：http://<host>:4000/v1）。
# 留空 = 不播种生成模型；启用 local-embedding profile 时运行期仍会回落到 model-gateway。
GENERATION_GATEWAY_URL=

# ---------- 模型清单：首次播种 + 回落 ----------
# ⚠️ **权威来源是 `model_registry` 表**（模型管理页 #/model 可增删，
#    保存即生效、不需要重启；见 contracts/model-gateway.md）。
#    下面这几项降级为：① 首次启动按 kind 空表播种进注册表；② 注册表读不到时逐项回落。
#
# 仍然**不要再往 application.yml / 代码常量 / compose 里抄第二份** —— 抄过 5 份，代价是
# 「画布选完、发布成功、跑起来才发现模型不存在」。
# 画布「大模型」下拉、preCheck 判据、编排运行期都从这份清单（或注册表）派生。
#
# 格式：model=显示名;model=显示名（分号分隔条目、等号分隔模型名与中文显示名）。
# 显示名可省略，省略时取模型名本身。
#
# ⚠️ 值必须带引号。docker compose 自己解析时加不加引号都对，但**用 shell 取值时不是**：
#    `set -a; . deploy/.env; set +a`（跑验证脚本、临时取 GENERATION_API_KEY 时会用）会把
#    分号当**命令分隔符**，变量被静默截断成只剩第一项 —— 不在 .env 这层报错，
#    只表现为容器里少了几个模型，极难排查。加引号后两种解析都正确（compose 会剥掉成对引号）。
# GENERATION_MODELS="your-chat-model=Your Chat Model;your-chat-model-2=Your Chat Model 2"

# 默认生成模型，**必须出现在上面清单里**（不在清单里 RKB 会打 ERROR 日志）。
# 画布上没显式选模型时用它做兜底。
GENERATION_MODEL=your-chat-model

# 探测可用模型用的路径（拼在 GENERATION_GATEWAY_URL 后面）。不同实现路径不同，故可配：
#   LiteLLM（本部署默认端点） → /models
#   Infinity（compose 内置的 embedding 容器）→ /models，但它的 base URL **不带 /v1**
# 探测是尽力而为：拿不到就视为「无法判定」，不判模型不可用（见 contracts/model-gateway.md）。
GENERATION_MODELS_PATH=/models

# 推理模型清单（逗号分隔）：问题重构算子选中它们时，preCheck 追加一条「较慢，是否继续」的
# 非阻塞警告。与 GENERATION_MODELS 同属部署属性，放一处便于一起改。
REASONING_MODELS=

# 端点需要鉴权时填这里。**只放本文件（.env 已 gitignore），不要写进代码或文档。**
# 探测可用模型也用它 —— 留空时探测会收到 401，表现为「无法判定」，不会误拦发布。
GENERATION_API_KEY=
# 推理模型先输出 reasoning_content：给小了会出现
# `content` 为空、`finish_reason=length` —— 看起来成功其实没答案。
# 实测：简单改写 1024 够用；**重排提示词**（把候选切片全塞进提示词让模型排序）会触发
# 6000+ 字符的推理，2048 token 直接被截断 → 重排拿不到结果。
# 开思考的回答生成预算要更大：8192 在多跳问题上仍偶发「思考吃满、正文为空」，
# 故默认给 16384。注意它必须小于 summarizer 的上下文窗口（默认 32768），
# 否则 PromptHelper 会算出负的可用上下文，答案生成直接 500。
GENERATION_MAX_TOKENS=16384
GENERATION_TEMPERATURE=0.01
GENERATION_TIMEOUT=120
# 推理模型的思考开关（OpenAI 兼容 `reasoning_effort`）。留空 = 不发送该字段。
# **只对 env 回落端点生效**；已注册模型以行内配置为准（行内 none 会压住本变量）。
# ⚠️ 实测部分推理模型不认顶层的 `reasoning_effort=none`，仍会思考；
# 要真正关闭请用下面的 GENERATION_CHAT_TEMPLATE_KWARGS。
GENERATION_REASONING_EFFORT=
# 推理模型的模板开关（JSON 对象）。留空 = 不发送该字段。
# 实测：部分推理模型的 {"thinking": false} 能把 reasoning_tokens 打到 0
# （延迟 0.39s → 0.12s）；顶层 reasoning_effort=none 无效。
# ⚠️ **推荐在模型管理页逐模型配置「思考配置」**
# （thinkingMode=auto/preset/custom；目录覆盖 DeepSeek/Qwen3/GLM/Kimi/MiniMax/
# GPT/Gemini/豆包/混元/星火等）。模型级配置用于**回答生成**；改写/重排/路由在
# 调用侧固定使用 aux（关闭或最低思考）的目录预置，**不读取行内 preset/custom**。
# 本变量只是**回落**：只对注册表不可用/模型未注册的端点生效；已注册模型以行内
# 配置为准（行内 none 会压住本变量）。
# 不同推理模型对该字段的支持不一致：有的忽略、仍会思考，有的能真正关闭。
# 注意：开关只解决延迟/空输出，不改变 LLM reranker 的排序质量。
GENERATION_CHAT_TEMPLATE_KWARGS=
# 重排专用模型（可选）：画布上 LLMReranker 未显式写 llm 时用它。推理模型做重排会先
# 思考很久（实测 20~60s，甚至把 max_tokens 烧完），建议配一个非推理模型。
GENERATION_RERANK_MODEL=

# 生成端点的主机名/IP（用于容器的 NO_PROXY 排除）。留空 = 不追加。
# 若所在网络有 HTTP 代理、而该端点不在代理覆盖范围内，**必须填**，否则容器直连会被
# 代理截胡而超时，表现为「/query 卡住」。
GENERATION_HOST=

# 可选：rerank 端点（OpenAI 兼容 rerank）。留空时 ExternalModelReranker 算子不可用：
# 保存时会提示、发布会被拒、运行时显式报错，而不是静默按原顺序返回。
# 它同时供给画布校验的判据（RKB_RERANK_URL）与编排运行期的实际调用 —— 现在两者是
# **同一个进程内的同一个值**（编排并入 RKB 前是「两个变量必须同源」，属易错点；
# 合并后这条约束由结构保证）。
RERANK_URL=
# 重排端点的主机名/IP（用于容器的 NO_PROXY 排除）。留空 = 不追加。
RERANK_HOST=

# 可选：rerank 请求体里的 `model` 字段。留空 → 回落到内置常量 `bge-reranker-large`
# （即与不配此项等价）。只有端点要求指定模型名时才需要填。
RERANK_MODEL=

# 敏感词黑名单目录（编排的合成算子用它做屏蔽）。默认 /app/black_list。
# ⚠️ 配上这一项**还不够**，要真生效还差三步（缺任何一环都是静默的）：
#   ① 把宿主目录挂进容器 —— 取消 `docker-compose.yml` 里 RKB 段那行 volumes 注释，
#      并用 BLACK_LIST_HOST_DIR 指向宿主目录（**镜像里没有这个目录**，不挂就没有）；
#   ② 在目录里放 `<词表名>.txt`（词之间用 `|#|` 分隔）；
#   ③ 画布里用了黑名单的合成算子要填 `black_vocabulary: <词表名>`。
# 另：**没有热更新**，换词表需重启容器。
BLACK_LIST_DIR=/app/black_list
# 宿主侧的词表目录（仅当启用了上面那行 volumes 时才用得到）。
BLACK_LIST_HOST_DIR=
# 大图谱抽图的沙箱超时（秒）；留空 = 默认 1800。数百 chunk 的库在慢网关上
# 可能超时，可单独放宽，不影响切分/解析。
OPERATOR_GRAPH_EXTRACT_TIMEOUT_SECONDS=
# 切分/解析沙箱子进程的内存配额（MB，默认 500）。上限 = 子进程基线 VmSize + 本值。
# ⚠️ 500 偏紧：解析器导入就要占掉大头（见下面 OPENBLAS_NUM_THREADS），留给文档的
# 只剩几十 MB，稍大的 PDF 会在结果回传处失败，对外表现为「切分算子执行失败」。
OPERATOR_MEMORY_LIMIT_MB=1024
# numpy 的 OpenBLAS/MKL 按线程数预分配缓冲区：8 核实测 VmSize +280MB（361MB → 81MB）。
# 解析/切分根本不用 BLAS，固定 1 线程既省内存也不会让沙箱和主进程抢 CPU。
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1

# 注：模型清单的权威来源是 `model_registry` 表（模型管理页），本文件是它的首次播种与回落。


# ---------- rag-knowledge-base（全栈唯一业务服务，8091）----------
# 所有接口统一走 /api/co-knowledge/v1。
# 全栈只有一个 PostgreSQL database，即上面的 POSTGRES_DB(=rag_studio)。
#
# 文件域的存储根必须与上面 STORAGE_MAIN_PATH 指向**同一个卷、同一个路径** ——
# 上传落盘后把绝对路径写进 t_directory，解析侧按同一路径去读。
# 一般不需要改：compose 直接复用了 STORAGE_MAIN_PATH 的值。
# RKB_KBASE_STORAGE_PATH=/data/kb
# 应用只读 RKB_DB_HOST/PORT/NAME/USER/PASSWORD；前三个由 compose 从上面的
# POSTGRES_* 映射，通常无需在本文件重复定义。
# PostgreSQL 连接池（RKB 业务库）。每个进程各一份；max_connections=100 时
# 多 worker 部署要相应调小或换 PgBouncer。
RKB_DB_POOL_MIN=1
RKB_DB_POOL_MAX=10
# 查询链路耗时入库（best-effort；关闭后不写 t_query_trace，不影响问答）。
RKB_QUERY_TRACE_ENABLED=true
# model_registry.api_key 的静态加密密钥（AES-256-GCM）。
# 留空 = 首次使用时生成到 RKB_SECRET_KEY_FILE（默认在 rkb-storage 卷里）。
# 多副本部署必须显式设置同一个 RKB_SECRET_KEY；**丢失密钥 = 已加密凭据不可恢复**。
RKB_SECRET_KEY=
RKB_SECRET_KEY_FILE=/data/rkb/secret.key
