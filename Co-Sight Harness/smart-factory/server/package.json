    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.2",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
