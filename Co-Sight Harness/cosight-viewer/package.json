{
  "name": "co-sight-viewer",
  "version": "1.2.1",
  "description": "Real-time dashboard for tracking Claude Code agent activity",
  "type": "commonjs",
  "main": "server/index.js",
  "files": [
    "build-info.json",
    "server/**/*.js",
    "!server/**/__tests__/**",
    "!server/**/__e2e__/**",
    "scripts/cli.js",
    "scripts/co-sight-viewer-start.cjs",
    "scripts/co-sight-viewer-stop.cjs",
    "scripts/lib/viewer-process.cjs",
    "scripts/postinstall-client.js",
    "scripts/install-hooks.js",
    "scripts/cosight-viewer-hook-handler.js",
    "scripts/uninstall.js",
    "scripts/selfcheck.js",
    "scripts/start.sh",
    "client/dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "co-sight-viewer": "scripts/cli.js"
  },
  "license": "Apache-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agent",
    "dashboard",
    "real-time",
    "monitoring",
    "activity-tracking",
    "mcp",
    "model-context-protocol",
    "nodejs",
    "express",
    "react",
    "websocket",
    "sqlite",
    "web-push",
    "vapid",
    "notifications",
    "productivity",
    "developer-tools"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .husky || true",
    "postinstall": "node scripts/postinstall-client.js || true",
    "build": "cd client && npm run build",
    "start": "node scripts/cli.js start",
    "stop": "node scripts/cli.js stop",
    "setup": "npm install && cd client && npm install",
    "update:pull-setup": "git pull --ff-only && npm run setup",
    "mcp:install": "npm --prefix mcp install",
    "mcp:build": "npm --prefix mcp run build",
    "mcp:start": "npm --prefix mcp run start",
    "mcp:start:http": "npm --prefix mcp run start:http",
    "mcp:start:repl": "npm --prefix mcp run start:repl",
    "mcp:dev": "npm --prefix mcp run dev",
    "mcp:dev:http": "npm --prefix mcp run dev:http",
    "mcp:dev:repl": "npm --prefix mcp run dev:repl",
    "mcp:typecheck": "npm --prefix mcp run typecheck",
    "install-hooks": "node scripts/install-hooks.js",
    "selfcheck": "node scripts/selfcheck.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "swagger-ui-express": "^5.0.1",
    "tar": "^7.4.3",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
