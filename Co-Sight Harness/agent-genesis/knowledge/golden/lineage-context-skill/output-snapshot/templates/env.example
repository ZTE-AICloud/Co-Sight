# 语义上下文管线环境变量契约（用户自备凭据模板）
#
# 复制为实际环境配置文件后填值; 占位值（your-...-here）视为未设置,
# 启动校验 fail-closed 拒执行。凭据只读本文件所在环境, 禁写入任何产物。

# =============================================================================
# 嵌入服务段（四选一, 启用所选段, 其余保持注释）
# =============================================================================
EMBEDDING_PROVIDER=OpenAI
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1   # 自定义端点时才解开

# VoyageAI
# VOYAGEAI_API_KEY=your-voyageai-api-key-here

# Gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ollama（本地嵌入, 无 API key）
# OLLAMA_MODEL=
# OLLAMA_HOST=http://localhost:11434

# =============================================================================
# 向量库段（用户自备端点与令牌）
# =============================================================================
VECTOR_DB_ADDRESS=your-vector-db-public-endpoint
VECTOR_DB_TOKEN=your-vector-db-token-here

# =============================================================================
# 切分段配置
# =============================================================================
SPLITTER_TYPE=ast           # ast 优先, langchain 兜底

# 可选扩展
# CUSTOM_EXTENSIONS=.vue,.svelte,.astro
# CUSTOM_IGNORE_PATTERNS=temp/**,*.backup,private/**
# HYBRID_MODE=true            # 向量+BM25 混合检索; 注释 = 纯向量
