# CoSightBot configuration (PKM + SOC 共用一份 .env)
# 技能脚本启动时自动加载本文件（数据根目录下的 .env）。shell 已 export 的变量优先。

# ── embedding 服务 ───────────────────────────────────────────────────────────
# SOC 必需：构建与查询 SOC 知识库的 OpenAI 兼容 embeddings 端点。
# PKM 动态概览必需：section 级向量索引与动态 resolve 依赖该端点。
# 使用服务方要求的完整 embeddings 端点 URL。
COSIGHTBOT_EMBEDDING_API_URL=
COSIGHTBOT_EMBEDDING_API_KEY=
# 标准 OpenAI 兼容 embeddings API 通常需要模型名；部分 BGE 风格端点不需要。
# COSIGHTBOT_EMBEDDING_MODEL=

# 对召回结果重排（PKM 动态检索强烈建议；未配置时退化为非 rerank 分数，
# 准确率明显下降。SOC 侧可选，未配置 URL 时跳过）。
# COSIGHTBOT_RERANK_API_URL=
# COSIGHTBOT_RERANK_MODEL=reranker

# ── 技能内部 LLM（OpenAI chat/completions 兼容协议）──────────────────────────
# 知识库构建、应答、复核、通读分析、文档图片/OCR 识别等均走该配置。
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# 回退：未配置 OPENAI_BASE_URL / OPENAI_API_KEY 时，继承 Claude Code 会话的
# ANTHROPIC_* 配置。注意端点仍需支持 OpenAI chat/completions 请求，仅支持
# Anthropic 原生协议的端点需配协议转换代理。
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=

# ── 可选：独立视觉端点（图片/OCR 识别；不配置时使用主 LLM 配置）─────────────
# COSIGHTBOT_VISION_API_URL=
# COSIGHTBOT_VISION_API_KEY=
# COSIGHTBOT_VISION_MODEL=
# COSIGHTBOT_MODEL_SUPPORTS_IMAGES=1

# ── 可选：构建期 M1 文档角色先验（弱标题文档由小模型分类）───────────────────
# 弱标题文档交给 OpenAI 兼容小模型分类（单篇一请求，基于 logprobs 置信度），
# 端点与密钥缺省复用 OPENAI_BASE_URL / OPENAI_API_KEY；不设模型名则跳过 M1
# （静态标题规则仍生效）。
# COSIGHTBOT_M1_ENABLED=1
# COSIGHTBOT_M1_MODEL=
# COSIGHTBOT_M1_BASE_URL=
# COSIGHTBOT_M1_API_KEY=
# COSIGHTBOT_M1_WORKERS=8
# COSIGHTBOT_M1_TIMEOUT_S=60

# ── 可选：内部 LLM 调用的上下文窗口与最大输出 ────────────────────────────────
# COSIGHTBOT_MODEL_CONTEXT_WINDOW=256000
# COSIGHTBOT_MODEL_MAX_TOKENS=

# ── 可选：embedding 请求调优 ─────────────────────────────────────────────────
# COSIGHTBOT_EMBEDDING_CONNECT_TIMEOUT=3
# COSIGHTBOT_EMBEDDING_READ_TIMEOUT=60
# COSIGHTBOT_EMBEDDING_MAX_ATTEMPTS=4
# COSIGHTBOT_EMBEDDING_RETRY_BACKOFF=2,5,15
# COSIGHTBOT_EMBEDDING_MAX_INPUT_CHARS=7800
# COSIGHTBOT_EMBEDDING_MAX_BATCH_TEXTS=100
# COSIGHTBOT_EMBEDDING_TIMEOUT_RETRIES=1

# ── 可选：文档预处理超时与兼容性 ─────────────────────────────────────────────
# COSIGHTBOT_PER_FILE_HARD_TIMEOUT=600
# COSIGHTBOT_PER_PAGE_TIMEOUT=300
# COSIGHTBOT_MAX_FAILED_PAGES=3
# COSIGHTBOT_PAGE_INGEST_INTERVAL=25
# COSIGHTBOT_VISION_TOTAL_TIMEOUT=120
# COSIGHTBOT_FORCE_LIBREOFFICE=1

# ── 可选：统一日志（<数据根>/logs/cosightbot.log，轮转）─────────────────────
# COSIGHTBOT_LOG_LEVEL=INFO
# COSIGHTBOT_LOG_MAX_BYTES=20971520
# COSIGHTBOT_LOG_BACKUP_COUNT=5

# ── 可选：PKM 全量构建中的中间概览刷新 ────────────────────────────────────
# 中间刷新省略 section 标题避免重读全部 md（51W 规模每次全量刷新约 12 分钟）。
# 最终刷新始终包含 section。设 INTERMEDIATE=0 只保留首次（尽早可用）和最终刷新。
# 超过 MAX_FILES（默认 50000）时自动禁用中间刷新（51W 规模下全量重写目录树需分钟级）。
# COSIGHTBOT_OVERVIEW_REFRESH_INTERMEDIATE=1
# COSIGHTBOT_OVERVIEW_INTERMEDIATE_MAX_FILES=50000
# COSIGHTBOT_OVERVIEW_REFRESH_SHOW_SECTIONS=0

# ── 可选：PKM section 级知识索引（LanceDB + tantivy FTS）──────────────────
# COSIGHTBOT_SECTION_INDEX=1
# COSIGHTBOT_SECTION_EMBED_BATCH=4
# COSIGHTBOT_SECTION_BATCH_DOCS=200
# COSIGHTBOT_SECTION_ANN=1
# COSIGHTBOT_SECTION_ANN_THRESHOLD=100000
# COSIGHTBOT_SECTION_BUILD_STALE_SECONDS=43200

# ── 可选：PKM 动态概览（resolve）调优（标定参数，通常保持默认）────────────
# H1 默认值在 51W 500q 上标定（Tier1 recall 81.13%，p95 ~23s）。
# COSIGHTBOT_DYNAMIC_TAU=0.10
# COSIGHTBOT_DYNAMIC_HIT_THRESHOLD=0.40
# COSIGHTBOT_DYNAMIC_TIER1_LIMIT=100
# COSIGHTBOT_DYNAMIC_TIER2_LIMIT=150
# COSIGHTBOT_DYNAMIC_RERANK_BLOCKS=1200
# COSIGHTBOT_DYNAMIC_RERANK_PER_DOC=5
# COSIGHTBOT_DYNAMIC_RERANK_MAX_BATCH=200
# COSIGHTBOT_DYNAMIC_SEMANTIC_TOP_K=1000
# COSIGHTBOT_DYNAMIC_SKELETON_TOP_K=500
# COSIGHTBOT_DYNAMIC_BODY_TOP_K=800
# COSIGHTBOT_DYNAMIC_SCORE_MODE=hybrid
# COSIGHTBOT_DYNAMIC_HYBRID_WEIGHT=1.0
# COSIGHTBOT_DYNAMIC_HOP2_NEW_DOCS_ONLY=1
# COSIGHTBOT_DYNAMIC_HOP2_RERANK_BLOCKS=400
# COSIGHTBOT_DYNAMIC_HOP2_MAX_QUESTIONS=1
# COSIGHTBOT_DYNAMIC_HOP2_SKIP_FULL_HIT=0
# 可选：Q0 查询改写（复用同一 LLM，默认关闭）。
# COSIGHTBOT_DYNAMIC_QUERY_REWRITE=0
# COSIGHTBOT_DYNAMIC_QUERY_REWRITE_TIMEOUT=30
# COSIGHTBOT_DYNAMIC_QUERY_REWRITE_MAX_QUESTIONS=1
# COSIGHTBOT_DYNAMIC_OUTPUT_TOKENS=35000
# P1 标定值：30K evidence 使 Tier1 持平且 A0 p50 降低约 3s。
# COSIGHTBOT_DYNAMIC_EVIDENCE_TOKENS=30000
# COSIGHTBOT_DYNAMIC_A0_MAX_TOKENS=3000
# COSIGHTBOT_DYNAMIC_A0_TIMEOUT=120
# COSIGHTBOT_DYNAMIC_A0_JSON_MODE=1
# COSIGHTBOT_FORCE_DYNAMIC=0

# ── 可选：JEV 结构化裁决（检索/核验 E1/E2/A1/A2/A3 五节点）──────────────────
# 生产默认仅使用私有化部署的内部 JEV（绝不自动回退公网端点）。
# COSIGHTBOT_JEV_ENABLED=0
# COSIGHTBOT_JEV_STAGES=E1,E2,A1,A2,A3
# COSIGHTBOT_JEV_CHANNEL=internal
# COSIGHTBOT_JEV_INTERNAL_ENDPOINTS=
# COSIGHTBOT_JEV_INTERNAL_MODEL=
# COSIGHTBOT_JEV_INTERNAL_API_KEY=
# COSIGHTBOT_JEV_TIMEOUT_S=30
# COSIGHTBOT_JEV_E2_BATCH_DOCS=1
# COSIGHTBOT_JEV_E2_WORKERS=6
# COSIGHTBOT_JEV_A1_BATCH_ITEMS=1
# 仅基准评测可用的备选通道（仅当 COSIGHTBOT_JEV_CHANNEL=external 时读取；
# 也接受 JEV_EXTERNAL_ENDPOINTS / JEV_EXTERNAL_MODEL / JEV_EXTERNAL_API_KEY 别名）：
# COSIGHTBOT_JEV_EXTERNAL_ENDPOINTS=
# COSIGHTBOT_JEV_EXTERNAL_MODEL=
# COSIGHTBOT_JEV_EXTERNAL_API_KEY=

# ── 可选：调试日志与数据位置 ─────────────────────────────────────────────────
# COSIGHTBOT_DEBUG=1
# COSIGHTBOT_HOME=

# install.py 会探测并写入 SSL_CERT_FILE；若 https 证书校验失败，手动改为
# 你的 CA 证书包路径。
# SSL_CERT_FILE=
